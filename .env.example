# Copy this file to .env and customise. docker-compose will pick it up.

# Forward every saved order to your Google Apps Script web app (leave empty to disable).
GOOGLE_APPS_SCRIPT_URL=

# Letterhead values printed on the PDF invoices and the history report.
SHOP_NAME=SKT Order Book
